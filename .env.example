# Public DNS name for your Foundry site, for example: foundry.example.com
FOUNDRY_HOSTNAME=foundry.example.com

# Local HTTP origin for your Cloudflare Tunnel connector.
# Point the connector at http://localhost:8080.
ORIGIN_HTTP_PORT=8080

# Cloudflare terminates public HTTPS, then connects to this local HTTP origin.
# Keep these as true/443 so Foundry generates correct public URLs.
FOUNDRY_PROXY_SSL=true
FOUNDRY_PROXY_PORT=443

# Set to true only after you want Foundry options to stop following .env changes.
CONTAINER_PRESERVE_CONFIG=false

# Foundry VTT download source. Either set FOUNDRY_RELEASE_URL from your
# foundryvtt.com purchased licenses page, or set username/password below.
FOUNDRY_RELEASE_URL=

# Foundry VTT account credentials used by the container to download Foundry
# when FOUNDRY_RELEASE_URL is blank.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=

# Foundry license and admin password.
FOUNDRY_LICENSE_KEY=
FOUNDRY_ADMIN_KEY=change-this-admin-password
